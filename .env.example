GEMINI_API_KEY=your_gemini_api_key_here

# Required in production — use something long and random (e.g. openssl rand -hex 32).
SESSION_SECRET=generate_a_long_random_string

# Optional: Google OAuth (omit to keep “Continue with Google” disabled server-side redirect).
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# development | production
NODE_ENV=development

# Optional: lock CORS when the frontend is hosted on a different origin.
# CLIENT_ORIGIN=http://localhost:3000